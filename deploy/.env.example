# Développement local (deploy/local.yml et API lancée par cargo run). Valeurs sans secret réel.
DB_PASSWORD=liane
LIANE_HOME=.
DATABASE_URL=postgres://liane:liane@localhost:5432/liane
JWT_SECRET=dev-secret-change-me
# log : le code de connexion est écrit dans les journaux de l'API, aucun SMS ne part.
SMS_PROVIDER=log
# Vide : tracés en ligne droite.
OSRM_URL=http://localhost:5001
# Conteneur OSRM de gjini.co, joint par un tunnel SSH que liane start ouvre sur le port d'OSRM_URL
# (accès SSH à gjini.co requis). Vider pour s'en passer, ou pour le service osrm de local.yml.
OSRM_TUNNEL=liane-agent-osrm
# Mettre osrm pour démarrer le service osrm de local.yml (fichiers attendus dans data/osrm), OSRM_TUNNEL vide.
COMPOSE_PROFILES=
OSRM_DATA_FILE=occitanie.osrm
# Partage des frais : tarif en centimes par kilomètre. Valeur d'exemple pour le développement, à ajuster.
# Vide : pas de partage des frais, le porte-monnaie n'est pas proposé.
COST_SHARE_CENTS_PER_KM=10
# Compte de démonstration administrateur à code fixe : développement uniquement.
AUTH_TEST_ACCOUNT_ENABLED=true
AUTH_TEST_ACCOUNT=+33600000000
AUTH_TEST_CODE=000000
