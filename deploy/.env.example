# Développement local (deploy/local.yml et API lancée par cargo run). Valeurs sans secret réel.
DB_PASSWORD=liane
LIANE_HOME=.
DATABASE_URL=postgres://liane:liane@localhost:5432/liane
JWT_SECRET=dev-secret-change-me
# log : le code de connexion est écrit dans les journaux de l'API, aucun SMS ne part.
SMS_PROVIDER=log
# Vide : tracés en ligne droite. Sinon l'adresse d'un serveur OSRM.
OSRM_URL=
# Compte de démonstration administrateur à code fixe : développement uniquement.
AUTH_TEST_ACCOUNT_ENABLED=true
AUTH_TEST_ACCOUNT=+33600000000
AUTH_TEST_CODE=000000
