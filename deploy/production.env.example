# Variables de deploy/production.yml. Copier en .env (ignoré par git) et remplir.
# Générer un secret : openssl rand -hex 32

# --- Obligatoires ---
# Nom de domaine servi par Traefik (site, /api et /tiles).
DOMAIN=liane.example.org
# Mot de passe de la base. Il entre dans une URL : lettres et chiffres seulement.
DB_PASSWORD=
# Secret de signature des jetons de session. Le changer déconnecte tout le monde.
JWT_SECRET=
# Envoi des codes de connexion : brevo (réel) ou log (développement : le code est écrit dans les journaux).
SMS_PROVIDER=brevo
# Clé d'API Brevo, obligatoire si SMS_PROVIDER=brevo.
SMS_API_KEY=

# --- Reverse proxy ---
# Réseau Docker externe partagé avec Traefik, point d'entrée et résolveur de certificats.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
# Nombre de mandataires de confiance devant l'API (1 : Traefik seul ; 2 : un CDN reconnu par Traefik, puis Traefik).
TRUSTED_PROXY_COUNT=1

# --- Facultatives ---
# Nom d'expéditeur des SMS (11 caractères au plus).
SMS_SENDER=Liane
# Notifications : log (rien n'est envoyé) ou webpush. Avec webpush, les trois variables VAPID sont obligatoires.
# Générer la paire de clés : voir « Notifications Web Push » dans le README.
PUSH_PROVIDER=log
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact de l'exploitant transmis aux services de push : mailto:… ou https://…
VAPID_SUBJECT=
# Serveur OSRM pour le tracé des lianes. Vide : lignes droites. Avec le profil osrm : http://liane-osrm:5000
OSRM_URL=
OSRM_DATA_DIR=./osrm-data
OSRM_DATA_FILE=occitanie.osrm
# Origines autorisées à appeler l'API depuis un autre site (séparées par des virgules). Vide : aucune.
CORS_ALLOWED_ORIGINS=
# Clé publique MapTiler du fond de carte, incluse dans le site à la construction. Vide : fond neutre.
MAPTILER_KEY=
# Images déjà construites, si elles viennent d'un registre.
API_IMAGE=liane-api:latest
WEB_IMAGE=liane-web:latest
# Durée de conservation des sauvegardes (profil backup).
BACKUP_KEEP_DAYS=14

# Ne JAMAIS activer en production : compte de démonstration administrateur à code fixe.
# AUTH_TEST_ACCOUNT_ENABLED, AUTH_TEST_ACCOUNT et AUTH_TEST_CODE ne sont volontairement pas transmis par production.yml.
